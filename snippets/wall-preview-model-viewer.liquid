<div class="model-viewer-ar-modal" data-model-viewer-modal>
  <div class="model-viewer-ar-modal__header">
    <button class="model-viewer-ar-modal__close" data-model-viewer-close aria-label="Cerrar">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    <h3 class="model-viewer-ar-modal__title">Vista AR Nativa</h3>
  </div>

  <div class="model-viewer-ar-modal__container" data-model-viewer-container>
    <model-viewer
      id="artwork-viewer"
      data-model-viewer
      camera-controls
      touch-action="pan-y"
      ar
      ar-modes="scene-viewer webxr quick-look"
      ar-scale="auto"
      shadow-intensity="1"
      style="width: 100%; height: 100%;"
    >
      <button slot="ar-button" class="model-viewer-ar-modal__ar-button">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
        </svg>
        Activar AR
      </button>
      
      <div class="model-viewer-ar-modal__progress-bar" slot="progress-bar">
        <div class="model-viewer-ar-modal__progress-bar-fill"></div>
      </div>
    </model-viewer>
    
    <div class="model-viewer-ar-modal__instructions">
      <p>👆 Toca "Activar AR" para ver el cuadro en tu espacio</p>
    </div>
  </div>

  <div class="model-viewer-ar-modal__loading" data-model-viewer-loading style="display: none;">
    <div class="model-viewer-ar-modal__loading-spinner"></div>
    <p class="model-viewer-ar-modal__loading-text">Preparando modelo 3D...</p>
  </div>

  <div class="model-viewer-ar-modal__error" data-model-viewer-error style="display: none;">
    <div class="model-viewer-ar-modal__error-icon">⚠️</div>
    <p class="model-viewer-ar-modal__error-text" data-model-viewer-error-text></p>
    <button class="model-viewer-ar-modal__error-btn" data-model-viewer-close>Cerrar</button>
  </div>
</div>


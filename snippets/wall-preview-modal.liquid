<div class="wall-preview-modal" data-wall-preview-modal>
  <div class="wall-preview-modal__overlay" data-wall-preview-close></div>
  
  <div class="wall-preview-modal__container">
    <div class="wall-preview-modal__header">
      <h2 class="wall-preview-modal__title">Ver en mi pared</h2>
      <button 
        type="button" 
        class="wall-preview-modal__close-btn" 
        data-wall-preview-close
        aria-label="Cerrar"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="wall-preview-modal__upload-section">
      <label for="wall-upload" class="wall-preview-modal__upload-label">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="17 8 12 3 7 8"></polyline>
          <line x1="12" y1="3" x2="12" y2="15"></line>
        </svg>
        <span class="wall-preview-modal__upload-text">Sube una foto de tu pared</span>
        <span class="wall-preview-modal__upload-hint">Click para seleccionar una imagen</span>
      </label>
      <input 
        type="file" 
        id="wall-upload" 
        accept="image/*" 
        class="wall-preview-modal__upload-input"
        data-wall-upload
      >
    </div>

    <div 
      class="wall-preview-modal__preview-container" 
      id="preview-container"
      data-preview-container
    >
    </div>

    <div class="wall-preview-modal__controls">
      <div class="wall-preview-modal__slider-container">
        <label for="size-slider" class="wall-preview-modal__slider-label">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
          </svg>
          Tamaño del cuadro
        </label>
        <input 
          type="range" 
          id="size-slider" 
          min="10" 
          max="80" 
          value="25" 
          class="wall-preview-modal__slider"
          data-size-slider
        >
      </div>
    </div>
  </div>
</div>


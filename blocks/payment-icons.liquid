
{% assign block_settings = block.settings %}

{%- assign block_settings = block.settings -%}

<div
  class="
    payment-icons
    spacing-style
  "
  style="
    {% render 'spacing-padding', settings: block_settings %}
    --icon-gap: {{ block_settings.gap }}px;
    --alignment: {{ block_settings.horizontal_alignment }};
  "
  {{ block.shopify_attributes }}
>
  <span class="visually-hidden">{{ 'blocks.payment_methods' | t }}</span>
  <ul
    class="payment-icons__list"
    role="list"
  >
    {%- for type in shop.enabled_payment_types -%}
      <li class="payment-icons__item">
        {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
      </li>
    {%- endfor -%}
    {%- if block_settings.custom_payment_1 != blank -%}
      {% liquid
        assign icon1_width = block_settings.custom_payment_1_width | default: 60
      %}
      <li class="payment-icons__item payment-icons__item--custom">
        <img
          src="{{ block_settings.custom_payment_1 | image_url: width: 300 }}"
          srcset="{%- if block_settings.custom_payment_1.width >= 120 -%}{{ block_settings.custom_payment_1 | image_url: width: 120 }} 120w,{%- endif -%}
                  {%- if block_settings.custom_payment_1.width >= 180 -%}{{ block_settings.custom_payment_1 | image_url: width: 180 }} 180w,{%- endif -%}
                  {%- if block_settings.custom_payment_1.width >= 240 -%}{{ block_settings.custom_payment_1 | image_url: width: 240 }} 240w,{%- endif -%}
                  {%- if block_settings.custom_payment_1.width >= 300 -%}{{ block_settings.custom_payment_1 | image_url: width: 300 }} 300w{%- endif -%}"
          width="{{ icon1_width }}"
          height="auto"
          loading="lazy"
          alt="{{ block_settings.custom_payment_1_alt | default: 'Payment method' }}"
          class="payment-icons__custom-icon payment-icons__custom-icon--1"
          style="width: {{ icon1_width }}px; height: auto;"
        >
      </li>
    {%- endif -%}
    {%- if block_settings.custom_payment_2 != blank -%}
      {% liquid
        assign icon2_width = block_settings.custom_payment_2_width | default: 60
      %}
      <li class="payment-icons__item payment-icons__item--custom">
        <img
          src="{{ block_settings.custom_payment_2 | image_url: width: 300 }}"
          srcset="{%- if block_settings.custom_payment_2.width >= 120 -%}{{ block_settings.custom_payment_2 | image_url: width: 120 }} 120w,{%- endif -%}
                  {%- if block_settings.custom_payment_2.width >= 180 -%}{{ block_settings.custom_payment_2 | image_url: width: 180 }} 180w,{%- endif -%}
                  {%- if block_settings.custom_payment_2.width >= 240 -%}{{ block_settings.custom_payment_2 | image_url: width: 240 }} 240w,{%- endif -%}
                  {%- if block_settings.custom_payment_2.width >= 300 -%}{{ block_settings.custom_payment_2 | image_url: width: 300 }} 300w{%- endif -%}"
          width="{{ icon2_width }}"
          height="auto"
          loading="lazy"
          alt="{{ block_settings.custom_payment_2_alt | default: 'Payment method' }}"
          class="payment-icons__custom-icon payment-icons__custom-icon--2"
          style="width: {{ icon2_width }}px; height: auto;"
        >
      </li>
    {%- endif -%}
    {%- if block_settings.custom_payment_3 != blank -%}
      {% liquid
        assign icon3_width = block_settings.custom_payment_3_width | default: 60
      %}
      <li class="payment-icons__item payment-icons__item--custom">
        <img
          src="{{ block_settings.custom_payment_3 | image_url: width: 300 }}"
          srcset="{%- if block_settings.custom_payment_3.width >= 120 -%}{{ block_settings.custom_payment_3 | image_url: width: 120 }} 120w,{%- endif -%}
                  {%- if block_settings.custom_payment_3.width >= 180 -%}{{ block_settings.custom_payment_3 | image_url: width: 180 }} 180w,{%- endif -%}
                  {%- if block_settings.custom_payment_3.width >= 240 -%}{{ block_settings.custom_payment_3 | image_url: width: 240 }} 240w,{%- endif -%}
                  {%- if block_settings.custom_payment_3.width >= 300 -%}{{ block_settings.custom_payment_3 | image_url: width: 300 }} 300w{%- endif -%}"
          width="{{ icon3_width }}"
          height="auto"
          loading="lazy"
          alt="{{ block_settings.custom_payment_3_alt | default: 'Payment method' }}"
          class="payment-icons__custom-icon payment-icons__custom-icon--3"
          style="width: {{ icon3_width }}px; height: auto;"
        >
      </li>
    {%- endif -%}
    {%- if block_settings.visa_logo != blank -%}
      {% liquid
        assign visa_width = block_settings.visa_width | default: 60
      %}
      <li class="payment-icons__item payment-icons__item--custom">
        <img
          src="{{ block_settings.visa_logo | image_url: width: 300 }}"
          srcset="{%- if block_settings.visa_logo.width >= 120 -%}{{ block_settings.visa_logo | image_url: width: 120 }} 120w,{%- endif -%}
                  {%- if block_settings.visa_logo.width >= 180 -%}{{ block_settings.visa_logo | image_url: width: 180 }} 180w,{%- endif -%}
                  {%- if block_settings.visa_logo.width >= 240 -%}{{ block_settings.visa_logo | image_url: width: 240 }} 240w,{%- endif -%}
                  {%- if block_settings.visa_logo.width >= 300 -%}{{ block_settings.visa_logo | image_url: width: 300 }} 300w{%- endif -%}"
          width="{{ visa_width }}"
          height="auto"
          loading="lazy"
          alt="Visa"
          class="payment-icons__custom-icon payment-icons__custom-icon--visa"
          style="width: {{ visa_width }}px; height: auto;"
        >
      </li>
    {%- endif -%}
    {%- if block_settings.mastercard_logo != blank -%}
      {% liquid
        assign mastercard_width = block_settings.mastercard_width | default: 60
      %}
      <li class="payment-icons__item payment-icons__item--custom">
        <img
          src="{{ block_settings.mastercard_logo | image_url: width: 300 }}"
          srcset="{%- if block_settings.mastercard_logo.width >= 120 -%}{{ block_settings.mastercard_logo | image_url: width: 120 }} 120w,{%- endif -%}
                  {%- if block_settings.mastercard_logo.width >= 180 -%}{{ block_settings.mastercard_logo | image_url: width: 180 }} 180w,{%- endif -%}
                  {%- if block_settings.mastercard_logo.width >= 240 -%}{{ block_settings.mastercard_logo | image_url: width: 240 }} 240w,{%- endif -%}
                  {%- if block_settings.mastercard_logo.width >= 300 -%}{{ block_settings.mastercard_logo | image_url: width: 300 }} 300w{%- endif -%}"
          width="{{ mastercard_width }}"
          height="auto"
          loading="lazy"
          alt="Mastercard"
          class="payment-icons__custom-icon payment-icons__custom-icon--mastercard"
          style="width: {{ mastercard_width }}px; height: auto;"
        >
      </li>
    {%- endif -%}
  </ul>
</div>

{% stylesheet %}
  .payment-icons {
    width: 100%;
  }

  .payment-icons__list {
    display: flex;
    align-items: center;
    justify-content: var(--alignment);
    flex-wrap: wrap;
    gap: var(--icon-gap);
    margin: 0;
    padding: 0;
  }

  .payment-icons__item {
    display: flex;
    align-items: center;
  }

  .payment-icons__custom-icon {
    height: auto;
    object-fit: contain;
    image-rendering: -webkit-optimize-contrast;
    image-rendering: crisp-edges;
    display: block;
  }

  .payment-icons__item--custom {
    display: flex;
    align-items: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.payment_icons",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        },
        {
          "value": "space-between",
          "label": "t:options.space_between"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "Custom Payment Methods"
    },
    {
      "type": "image_picker",
      "id": "custom_payment_1",
      "label": "Custom Payment Icon 1",
      "info": "Upload MercadoPago or other payment method logo"
    },
    {
      "type": "text",
      "id": "custom_payment_1_alt",
      "label": "Custom Payment 1 Alt Text",
      "default": "MercadoPago"
    },
    {
      "type": "range",
      "id": "custom_payment_1_width",
      "label": "Custom Payment 1 Width",
      "min": 30,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 60,
      "info": "Height will be auto to maintain aspect ratio"
    },
    {
      "type": "image_picker",
      "id": "custom_payment_2",
      "label": "Custom Payment Icon 2",
      "info": "Upload Vanti or other payment method logo"
    },
    {
      "type": "text",
      "id": "custom_payment_2_alt",
      "label": "Custom Payment 2 Alt Text",
      "default": "Vanti"
    },
    {
      "type": "range",
      "id": "custom_payment_2_width",
      "label": "Custom Payment 2 Width",
      "min": 30,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 60,
      "info": "Height will be auto to maintain aspect ratio"
    },
    {
      "type": "image_picker",
      "id": "custom_payment_3",
      "label": "Custom Payment Icon 3",
      "info": "Upload additional payment method logo (optional)"
    },
    {
      "type": "text",
      "id": "custom_payment_3_alt",
      "label": "Custom Payment 3 Alt Text",
      "default": "Payment method"
    },
    {
      "type": "range",
      "id": "custom_payment_3_width",
      "label": "Custom Payment 3 Width",
      "min": 30,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 60,
      "info": "Height will be auto to maintain aspect ratio"
    },
    {
      "type": "header",
      "content": "Credit Cards"
    },
    {
      "type": "image_picker",
      "id": "visa_logo",
      "label": "Visa Logo",
      "info": "Upload Visa logo (optional)"
    },
    {
      "type": "range",
      "id": "visa_width",
      "label": "Visa Logo Width",
      "min": 30,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 60,
      "info": "Height will be auto to maintain aspect ratio"
    },
    {
      "type": "image_picker",
      "id": "mastercard_logo",
      "label": "Mastercard Logo",
      "info": "Upload Mastercard logo (optional)"
    },
    {
      "type": "range",
      "id": "mastercard_width",
      "label": "Mastercard Logo Width",
      "min": 30,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 60,
      "info": "Height will be auto to maintain aspect ratio"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.payment_icons",
      "category": "t:categories.footer"
    }
  ]
}
{% endschema %}
